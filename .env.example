# Copy this file to .env.local and fill in the values. Do NOT commit .env.local.
# Milestone 1 (Supabase). Found in Supabase: Project Settings > API Keys.
# Use the project URL and the PUBLISHABLE key. Never use the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Milestone 4 (Claude API). Server-only: this one must never start with NEXT_PUBLIC_
ANTHROPIC_API_KEY=

# AI drafting (Google Gemini, free tier). Server-only: must never start with NEXT_PUBLIC_.
# Create a key at https://aistudio.google.com/apikey. Leave empty to hide the "Draft with AI" button.
GEMINI_API_KEY=
# Optional: which free Gemini model to use (default gemini-3.6-flash; falls back to gemini-3.5-flash-lite).
GEMINI_MODEL=
